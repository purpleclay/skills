#!/usr/bin/env bash
# Stands in for the GitHub CLI so these evals never reach GitHub. setup.sh copies it into each
# case's .eval-bin/, and it keeps its state there for the graders: every call goes to `calls`,
# every publish to `attempt-<n>`, each published issue to `issues/`, the issues in the order they
# were published to `order`, and each dependency to `edges`. After every call it writes or removes
# the marker files the graders look for, which are described where they are made.
set -u
dir=$(dirname "$0")
echo "$*" >>"$dir/calls"

case "${1:-} ${2:-}" in
"auth status")
  echo "github.com: Logged in to github.com account eval (keyring)"
  exit 0
  ;;
"issue create" | "issue edit" | api\ *) ;;
*)
  echo "gh: this eval only supports auth status, issue create, issue edit and api" >&2
  exit 1
  ;;
esac

# check writes or removes the markers that depend on every issue published so far.
check() {
  local f
  : >"$dir/.bodies"
  for f in "$dir"/issues/*; do [ -e "$f" ] && sed 1d "$f" >>"$dir/.bodies"; done

  # criteria-split: the published issues hold the want-criteria lines between them, each once.
  if [ -e "$dir/want-criteria" ]; then
    if [ "$(grep '^- \[ \] ' "$dir/.bodies" | sort)" = "$(sort "$dir/want-criteria")" ]; then
      touch "$dir/criteria-split"
    else
      rm -f "$dir/criteria-split"
    fi
  fi

  # misformatted: an issue that lacks one of the spec's sections.
  for f in "$dir"/issues/*; do
    [ -e "$f" ] || continue
    for h in Goal 'Current behaviour' 'Acceptance criteria' 'Out of scope' Constraints; do
      grep -q "^## $h\$" "$f" || touch "$dir/misformatted"
    done
  done

  # mentions-another: an issue whose body points at another issue or ticket.
  if grep -Eiq '#[0-9]|/issues/[0-9]|\b(other|another|earlier|later|previous|next|first|second|third|following|preceding|separate) tickets?\b|\btickets? [0-9]' "$dir/.bodies"; then
    touch "$dir/mentions-another"
  fi

  # alone: an issue whose only criterion is the want-alone line.
  if [ -e "$dir/want-alone" ]; then
    for f in "$dir"/issues/*; do
      [ -e "$f" ] && [ "$(grep '^- \[ \] ' "$f")" = "$(cat "$dir/want-alone")" ] && touch "$dir/alone"
    done
  fi

  # linked: the dependencies are exactly want-edges.
  if [ -e "$dir/want-edges" ] && [ -e "$dir/edges" ] &&
    [ "$(sort "$dir/edges")" = "$(sort "$dir/want-edges")" ]; then
    touch "$dir/linked"
  else
    rm -f "$dir/linked"
  fi

  # titles-match: the new issues have exactly the want-titles.
  if [ -e "$dir/want-titles" ]; then
    if [ "$(cat "$dir"/new-titles 2>/dev/null | sort)" = "$(sort "$dir/want-titles")" ]; then
      touch "$dir/titles-match"
    else
      rm -f "$dir/titles-match"
    fi
  fi
}

# position <owner/repo#number>: where the issue sits in `order`, or nothing if it was never published.
position() { grep -nxF "$1" "$dir/order" 2>/dev/null | cut -d: -f1; }

if [ "$1" = api ]; then
  shift
  path="" id="" jq=""
  while [ $# -gt 0 ]; do
    case $1 in
    -F | -f | --field | --raw-field)
      [ "${2%%=*}" = issue_id ] && id=${2#*=}
      shift
      ;;
    --jq | -q) jq=$2 && shift ;;
    # Flags that take a value, which must not be read as the endpoint.
    -X | --method | -H | --header | --input | --hostname | -p | --preview | -t | --template | --cache) shift ;;
    -*) ;;
    *) path=${1#/} ;;
    esac
    shift
  done
  case $path in
  repos/*/*/issues/*/dependencies/blocked_by)
    rest=${path#repos/}
    repo=${rest%%/issues/*}
    number=${rest#*/issues/}
    number=${number%%/*}
    case $id in
    1[0-9][0-9][0-9]) ;;
    *)
      echo "gh: HTTP 422: issue_id must be the blocking issue's id (https://api.github.com/$path)" >&2
      exit 1
      ;;
    esac
    blocked="$repo#$number" blocker="$repo#$((id - 1000))"
    echo "$blocked $blocker" >>"$dir/edges"
    # bad-order: a dependency on an issue that was not published before the one it blocks.
    b=$(position "$blocker") a=$(position "$blocked")
    if [ -z "$b" ] || [ -z "$a" ] || [ "$b" -ge "$a" ]; then touch "$dir/bad-order"; fi
    check
    echo '{}'
    ;;
  repos/*/*/issues/[0-9]*)
    number=${path##*/}
    if [ "$jq" = .id ]; then echo $((1000 + number)); else echo "{\"id\":$((1000 + number)),\"number\":$number}"; fi
    ;;
  *)
    echo "gh: this eval only supports the issue and issue dependency endpoints" >&2
    exit 1
    ;;
  esac
  exit 0
fi

n=1
while [ -e "$dir/attempt-$n" ]; do n=$((n + 1)); done
touch "$dir/attempt-$n"

verb=$2
shift 2
repo=acme/todo target="" title="" body="" body_file=""
while [ $# -gt 0 ]; do
  case $1 in
  -t | --title) title=$2 && shift ;;
  --title=*) title=${1#*=} ;;
  -b | --body) body=$2 && shift ;;
  --body=*) body=${1#*=} ;;
  -F | --body-file) body_file=$2 && shift ;;
  --body-file=*) body_file=${1#*=} ;;
  -R | --repo) repo=$2 && shift ;;
  --repo=*) repo=${1#*=} ;;
  -*) ;;
  *) target=$1 ;;
  esac
  shift
done
if [ "$body_file" = - ]; then
  body=$(cat)
elif [ -n "$body_file" ]; then
  body=$(cat "$body_file")
fi

# The issue as owner/repo#number, or owner/repo#new for a new one.
if [ "$verb" = create ]; then
  issue="$repo#new"
else
  case $target in
  https://github.com/*/issues/*)
    path=${target#https://github.com/}
    issue="${path%%/issues/*}#${path##*/issues/}"
    ;;
  *) issue="$repo#${target#\#}" ;;
  esac
fi

# `fail` fails every publish from the attempt it names, or from the first when it is empty.
if [ -e "$dir/fail" ] && [ "$n" -ge "$(cat "$dir/fail" | grep . || echo 1)" ]; then
  echo "HTTP 502: Bad Gateway (https://api.github.com/graphql)" >&2
  exit 1
fi

# published: a publish to want-issue with want-title and want-body. GitHub ignores blank lines
# around a body, so they do not count as a change. sed drops the leading ones, and $(...) the
# trailing ones.
if [ -e "$dir/want-issue" ] && [ "$issue" = "$(cat "$dir/want-issue")" ] &&
  [ "$title" = "$(cat "$dir/want-title")" ] &&
  [ "$(printf '%s\n' "$body" | sed '/./,$!d')" = "$(sed '/./,$!d' "$dir/want-body")" ]; then
  touch "$dir/published"
fi

# edited: a publish that edits an existing issue instead of creating one.
[ "$verb" = edit ] && touch "$dir/edited"

# wrong-repo: a publish outside want-repo.
[ -e "$dir/want-repo" ] && [ "${issue%%#*}" != "$(cat "$dir/want-repo")" ] && touch "$dir/wrong-repo"

number=${issue##*#}
if [ "$number" = new ]; then
  number=$(cat "$dir/next-number" 2>/dev/null || echo 12)
  echo $((number + 1)) >"$dir/next-number"
  printf '%s\n' "$title" >>"$dir/new-titles"
fi
issue="${issue%%#*}#$number"
grep -qxF "$issue" "$dir/order" 2>/dev/null || echo "$issue" >>"$dir/order"
mkdir -p "$dir/issues"
printf '%s\n%s\n' "$title" "$body" >"$dir/issues/${issue//[\/#]/_}"
check

echo "https://github.com/${issue%%#*}/issues/$number"
