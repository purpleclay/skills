# Ignore everything and selectively allow files
*

!.envrc
!.gitignore
!.github/CODEOWNERS
!.github/workflows/*.yml
!.claude-plugin/*.json
!docs/**/*
!evals/**/*
!flake.lock
!flake.nix
!LICENSE
!README.md
!agents/**/*
!skills/**/*

# Recurse through sub-directories applying the same patterns
!*/

# Eval run output
evals/results/
